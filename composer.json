{
    "name": "capell-app/discovery-foundation",
    "description": "Shared public URL registry and deterministic discovery matching primitives for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/core": "^1.0.25",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\DiscoveryFoundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\DiscoveryFoundation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\DiscoveryFoundation\\Providers\\DiscoveryFoundationServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "homepage": "https://docs.capell.app/packages/discovery-foundation",
    "keywords": [
        "capell",
        "discovery",
        "url-registry",
        "cms"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/discovery-foundation"
    }
}
